{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "web",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "run",
        "dev"
      ],
      "port": 5173
    },
    {
      "name": "preview",
      "runtimeExecutable": "npx",
      "runtimeArgs": [
        "vite",
        "preview",
        "--port",
        "4174",
        "--strictPort"
      ],
      "port": 4174
    },
    {
      "name": "web-local-convex",
      "runtimeExecutable": "cmd",
      "runtimeArgs": [
        "/c",
        "set VITE_CONVEX_URL=http://127.0.0.1:3210&& npx vite --port 5199 --strictPort"
      ],
      "port": 5199
    }
  ]
}